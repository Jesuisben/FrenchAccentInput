#include <windows.h>
#include "resource_ids.h"

IDI_FAI_APP ICON "FrenchAccentInput.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,1,0
 PRODUCTVERSION 1,1,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "French Accent Input contributors\0"
            VALUE "FileDescription", "TypeIt-style French accent input for Windows\0"
            VALUE "FileVersion", "1.1.1\0"
            VALUE "InternalName", "FrenchAccentInput\0"
            VALUE "OriginalFilename", "FrenchAccentInput.exe\0"
            VALUE "ProductName", "French Accent Input\0"
            VALUE "ProductVersion", "1.1.1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
